# Written by setup on first run. Everything here has a working default, so an
# install needs nothing edited by hand.

# ---------- where clips live ----------
# A file and a folder beside the app's data. Nothing to install, nothing to
# keep running.
DATABASE_URL=sqlite:///./recording.db
LOCAL_STORAGE_DIR=./clips_local

# What the app calls itself in links. The tunnel overwrites this each start.
PUBLIC_BASE_URL=http://localhost:8000

# Loopback by default. 0.0.0.0 also serves the local network, which has no auth
# in front of it, so only on a network you trust.
BIND_HOST=127.0.0.1

# Lets another machine create its own account through setup. Blank closes
# registration; the host generates one on first start.
INVITE_CODE=

# Signs upload URLs. Generated per install.
UPLOAD_SECRET=

# ---------- publishing ----------
# The host opens its own tunnel so links work off this machine. A quick tunnel
# gets a new hostname every launch, so links from a previous session stop
# working: turn this off if that matters more than convenience.
MANAGE_TUNNEL=true

# ---------- this machine's client ----------
# Where clips are sent. Left at localhost, this machine hosts its own.
API_BASE_URL=http://localhost:8000
# Created by the app on first start when hosting.
ARETE_API_KEY=

RING_BUFFER_DIR=./ringbuf
CLIP_SECONDS=30
BUFFER_SECONDS=60
SEGMENT_SECONDS=2
CAPTURE_FPS=60
CAPTURE_BITRATE=12M
DDAGRAB_OUTPUT_IDX=0
HOTKEY_VK=0x78

# auto finds a loopback device, none records silent video, or name a dshow
# device. Windows has no loopback device by default.
AUDIO_DEVICE=auto

# Upload as soon as a clip is taken, rather than when you ask for a link.
AUTO_UPLOAD=false
