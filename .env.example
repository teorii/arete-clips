# Arete configuration, by example.
#
# Copy to .env to run from source. The packaged app writes its own at
# %APPDATA%\Arete\config.env and does not read this one.
#
# Anything absent falls back to the default in server/config.py or
# capture/config.py, and paths default to the data directory rather than
# whatever directory the app was started from.

# This machine hosts its own clips. Point it at another Arete to join that one instead.
API_BASE_URL=http://localhost:8000

# Issued by the app on first start. Blank here on purpose.
ARETE_API_KEY=

# What marks a machine configured. Setup writes it.
SETUP_COMPLETE=1

# Which display to record, counted from zero as ddagrab counts them.
DDAGRAB_OUTPUT_IDX=1

# How much of the past the hotkey keeps.
CLIP_SECONDS=15

# How far back the ring reaches. Twice the clip length, at least.
BUFFER_SECONDS=60

# Virtual-key code. 0x78 is F9.
HOTKEY_VK=0x78

# Ring segment length, and the granularity a cut can start on.
SEGMENT_SECONDS=2

CAPTURE_FPS=60

CAPTURE_BITRATE=12M

# Signs upload targets and clip previews. Generate your own.
UPLOAD_SECRET=

# Lets another machine create an account here. Blank disables that.
INVITE_CODE=

# Nudge the sound later if it arrives before what caused it. Normally nothing.
AUDIO_OFFSET_MS=0
