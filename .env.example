# ---------- server ----------
# SQLite by default so the app boots with zero setup.
# Supabase:  postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SQLite needs nothing installed. Self-hosted Postgres is the real target:
#   postgresql+psycopg://arete:<password>@127.0.0.1:5432/arete
DATABASE_URL=sqlite:///./recording.db

PUBLIC_BASE_URL=http://localhost:8000

# Loopback by default, so links only work on this machine. To share on your
# network set BIND_HOST=0.0.0.0 and point PUBLIC_BASE_URL at your LAN address,
# e.g. http://192.168.1.42:8000. There is no auth: anyone who can reach the
# port can view and delete clips, so only do this on a network you trust.
BIND_HOST=127.0.0.1

# Lets another machine create its own account through setup, so it needs one
# shared string rather than a key issued by hand. Blank closes registration.
# The host generates one on first start if this is empty.
INVITE_CODE=

# ---------- storage ----------
# local | r2
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./clips_local

# Object storage, used when STORAGE_BACKEND=s3. One backend covers a local
# MinIO, a MinIO on a server, Cloudflare R2, or S3 itself: presigned PUT and
# GET are all this uses, so self-hosted and managed are the same code path.
#
# Local MinIO:  http://127.0.0.1:9000
# Cloudflare:   https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=clips
S3_REGION=auto
# Where a browser fetches clips from. Blank means the endpoint plus the bucket,
# which is right for a local MinIO.
S3_PUBLIC_BASE_URL=
# Where clients are told to upload to. Blank means the same as S3_ENDPOINT_URL,
# which is correct only while every client is on this machine: an upload URL is
# signed for a specific host, and handing 127.0.0.1 to someone else's PC points
# it at their own machine. tools/start_tunnel.py sets this for you.
S3_PUBLIC_ENDPOINT_URL=
# MinIO addresses buckets by path. R2 accepts either, so leave this on.
S3_FORCE_PATH_STYLE=true
# Where a locally managed MinIO keeps its data. Blank puts it beside the app's
# other files. Set this if you already have a store you want kept.
MINIO_DATA_DIR=

# The host can start these itself, so they are not windows to remember.
# Tunnels get a new public hostname every launch, so links from a previous
# session stop working: turn this off if that matters more than convenience.
MANAGE_STORAGE=true
MANAGE_TUNNEL=true

# ---------- capture client ----------
API_BASE_URL=http://localhost:8000
# Issued by: python -m tools.add_user --handle <name>
# Decides whose library a clip lands in. Every machine gets its own.
ARETE_API_KEY=
RING_BUFFER_DIR=./ringbuf
CLIP_SECONDS=30
BUFFER_SECONDS=60
SEGMENT_SECONDS=2
CAPTURE_FPS=60
# auto = find a loopback device, none = silent video, or an exact dshow name.
# Windows has no loopback device by default; screen-capture-recorder provides
# one called virtual-audio-capturer.
AUDIO_DEVICE=auto
CAPTURE_BITRATE=10M
DDAGRAB_OUTPUT_IDX=0
HOTKEY_VK=0x78
