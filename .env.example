# ---------- server ----------
# SQLite by default so the app boots with zero setup.
# Supabase:  postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./recording.db

PUBLIC_BASE_URL=http://localhost:8000

# ---------- storage ----------
# local | r2
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./clips_local

# Cloudflare R2 (only read when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clips
# Public r2.dev URL or custom domain that serves the bucket
R2_PUBLIC_BASE_URL=

# ---------- capture client ----------
API_BASE_URL=http://localhost:8000
RING_BUFFER_DIR=./ringbuf
CLIP_SECONDS=30
BUFFER_SECONDS=60
SEGMENT_SECONDS=2
CAPTURE_FPS=60
CAPTURE_BITRATE=10M
DDAGRAB_OUTPUT_IDX=0
HOTKEY_VK=0x78
